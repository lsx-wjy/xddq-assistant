# 必须是已解析到此 ECS 公网 IP 的域名；不要填写 http:// 或 https://。
DASHBOARD_DOMAIN=xddq.example.com

# 仅用于 Let's Encrypt 证书到期等通知。
CADDY_EMAIL=admin@example.com

# 浏览器打开管理界面时使用的 HTTP Basic Auth 凭据。
# 请改成不重复使用的高强度密码；此文件权限应为 600。
DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password
