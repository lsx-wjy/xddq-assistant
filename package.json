{
    "name": "xddq-assistant",
    "version": "1.0.0",
    "main": "app.js",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22.5.0"
    },
    "imports": {
        "#*": "./src/*"
    },
    "dependencies": {
        "async": "^3.2.5",
        "axios": "^1.20.0",
        "crypto-js": "^4.2.0",
        "@lucide/vue": "^1.38.0",
        "long": "^5.2.3",
        "protobufjs": "^7.6.3",
        "qs": "^6.16.0",
        "uuid": "^11.1.1",
        "vue": "^3.5.13",
        "winston": "^3.13.0",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.1",
        "typescript": "^5.7.2",
        "vite": "^6.0.5",
        "vue-tsc": "^2.2.0"
    },
    "scripts": {
        "test": "node --test",
        "test:protocol-audit": "node --test scripts/protocol-audit.integration.mjs",
        "build": "npm test && npm run verify:protocols && npm run verify:protobuf-loader && npm run verify:gameplay-catalog && npm run dashboard:build",
        "start": "node app.js",
        "dashboard": "vite --config vite.config.ts",
        "dashboard:build": "vue-tsc --noEmit -p web/tsconfig.json && vite build --config vite.config.ts",
        "dashboard:preview": "vite preview --config vite.config.ts",
        "dashboard:serve": "node scripts/dashboard-server.mjs",
        "protocol:sync": "node scripts/sync-apk-protocols.mjs",
        "verify:protocols": "node scripts/verify-protocols.mjs",
        "verify:protobuf-loader": "node --expose-gc scripts/verify-protobuf-loader.mjs",
        "gameplay:sync": "node scripts/sync-gameplay-catalog.mjs",
        "verify:gameplay-catalog": "node scripts/verify-gameplay-catalog.mjs"
    }
}
