[
  {
    "id": "basic.chop-tree",
    "category": "basic",
    "name": "自动砍树与装备处理",
    "description": "连接期间持续砍树并处理掉落。筛选逻辑与游戏客户端一致：先按品质分解，再按妖力和两组攻击/抗性条件保留装备；默认保留时暂停，避免误分解。",
    "status": "ready",
    "manager": "PlayerAttributeMgr",
    "requires": [],
    "settingsSource": "apk",
    "settingsNote": "砍树的装备筛选项来自游戏客户端“自动模式”；脚本安全规则会单独标注，不会伪装成游戏设置。",
    "fields": [
      {"key":"peachLimit","label":"桃子下限","source":"script","type":"number","min":0,"max":999999999,"default":10000,"help":"脚本安全保护：桃子少于该数量时停止；游戏原生自动模式没有这一项"},
      {"key":"levelLimit","label":"停止等级","source":"script","type":"number","min":1,"max":9999,"default":375,"help":"脚本安全保护：达到或超过该等级时停止；游戏原生自动模式没有这一项"},
      {"key":"quality","label":"最低装备品质","type":"number","min":1,"max":34,"default":11,"help":"低于此品质会直接分解；游戏客户端将它作为第一道筛选"},
      {"key":"keepHigherPower","label":"妖力提升时暂停","type":"toggle","default":true,"help":"与游戏“妖力提升暂停”一致；开启后，新装备妖力高于当前角色时暂停自动处理"},
      {"key":"conditionMode","label":"妖力与属性条件","type":"select","default":1,"help":"当两类条件都启用时，决定保留规则","options":[{"label":"同时满足（与）","value":1},{"label":"满足任一（或）","value":0}]},
      {"key":"attributeGroupOneEnabled","label":"启用属性条件一","type":"toggle","default":false,"help":"一组中同时指定攻击与抗性时，掉落装备必须同时具备两项"},
      {"key":"attributeGroupOneAttack","label":"条件一：攻击属性","type":"select","default":0,"options":[{"label":"不限定","value":0},{"label":"击晕","value":5},{"label":"暴击","value":6},{"label":"连击","value":7},{"label":"闪避","value":8},{"label":"反击","value":9},{"label":"吸血","value":10}]},
      {"key":"attributeGroupOneResistance","label":"条件一：抗性属性","type":"select","default":0,"options":[{"label":"不限定","value":0},{"label":"抗击晕","value":11},{"label":"抗暴击","value":12},{"label":"抗连击","value":13},{"label":"抗闪避","value":14},{"label":"抗反击","value":15},{"label":"抗吸血","value":16}]},
      {"key":"attributeGroupTwoEnabled","label":"启用属性条件二","type":"toggle","default":false,"help":"可配置第二套属性组合；两套属性条件命中任一套即视为属性命中"},
      {"key":"attributeGroupTwoAttack","label":"条件二：攻击属性","type":"select","default":0,"options":[{"label":"不限定","value":0},{"label":"击晕","value":5},{"label":"暴击","value":6},{"label":"连击","value":7},{"label":"闪避","value":8},{"label":"反击","value":9},{"label":"吸血","value":10}]},
      {"key":"attributeGroupTwoResistance","label":"条件二：抗性属性","type":"select","default":0,"options":[{"label":"不限定","value":0},{"label":"抗击晕","value":11},{"label":"抗暴击","value":12},{"label":"抗连击","value":13},{"label":"抗闪避","value":14},{"label":"抗反击","value":15},{"label":"抗吸血","value":16}]},
      {"key":"autoCostMultiplierEnabled","label":"自动消耗倍率","type":"toggle","default":false,"help":"与游戏“自动消耗倍率”开关一致；关闭时每次只砍 1 次"},
      {"key":"autoCostMultiplier","label":"消耗倍率","type":"select","default":1,"help":"与游戏倍率下拉选择一致；超过当前仙树已解锁倍率时，会自动按可用最大值执行","options":[{"label":"1 倍","value":1},{"label":"2 倍","value":2},{"label":"3 倍","value":3},{"label":"4 倍","value":4},{"label":"5 倍","value":5},{"label":"6 倍","value":6}]},
      {"key":"matchedAction","label":"命中保留条件时","source":"script","type":"select","default":1,"help":"游戏客户端默认暂停；自动换装是脚本扩展，使用前请确认目标分身","options":[{"label":"按游戏逻辑暂停","value":1},{"label":"自动换装并继续","value":2}]},
      {"key":"autoEquipTarget","label":"自动换装目标","source":"script","type":"select","default":0,"help":"只在“自动换装并继续”时使用" ,"options":[{"label":"元体","value":0},{"label":"阳神","value":1},{"label":"阴身","value":2}]},
      {"key":"showResult","label":"显示详细装备日志","source":"script","type":"toggle","default":true,"help":"记录品质、妖力、属性命中与实际处理结果"}
    ]
  },
