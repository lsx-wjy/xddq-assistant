}
message FairyPartyDrawInfo {
    optional PlayerBaseDataMsg playerInfo = 1;
    optional int64 drawTime = 2;
    optional int32 rewardIndex = 3;
}
message FairyPartyVipSeatInfoSync {
    optional string partyId = 1;
    repeated FairyPartySeatInfo seatInfo = 2;
}
message FairyPartySeatRewardSync {
    optional string partyId = 1;
    optional int32 rewardIndex = 2;
    optional int32 bigRewardNum = 3;
    optional int32 joinPartyNum = 4;
    optional bool isVipSeat = 5;
    optional bool isHostReward = 6;
}
