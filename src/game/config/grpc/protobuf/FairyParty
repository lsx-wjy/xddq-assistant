message FairyPartySeatInfo {
    required int32 index = 1;
    optional PlayerBaseDataMsg playerInfo = 2;
    optional bool isBigReward = 3;
    optional FairyPartyDestinyInfo destiny = 4;
}
message FairyPartyAutoSetting {
    optional bool sameUnionAuto = 1;
    optional bool friendAuto = 2;
    optional int32 minRealmsAuto = 3;
    optional bool minRealmsAutoFlag = 4;
}
message FairyPartyApplyInfo {
    optional PlayerBaseDataMsg playerInfo = 1;
