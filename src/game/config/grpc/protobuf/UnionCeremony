package com.yq.msg.CityMsg;
import "WorldMessage";
import "WatchPlayer";
import "Union";
message UnionCeremonyUnionData {
    optional int64 unionId = 1;
    optional string name = 2;
    optional int64 serverId = 3;
    optional int64 flyTime = 4;
    optional int64 fightValue = 5;
    optional string leaderName = 6;
}
message UnionCeremonyCongratulationsInfo {
    optional int32 appearanceId = 1;
    optional int32 equipCloudId = 2;
    optional string wordsKey = 3;
    optional int64 sendTime = 4;
}
message UnionCeremonyListReq {
}
message UnionCeremonyListResp {
    required int32 ret = 1;
    repeated UnionCeremonyUnionData dataList = 2;
    repeated int64 serverIds = 3;
}
message UnionCeremonyVisitReq {
    required int64 unionId = 1;
    optional int64 lastCongratulationsTime = 2;
}
message UnionCeremonyVisitResp {
    required int32 ret = 1;
    optional OtherUnionData unionData = 2;
    repeated UnionCeremonyCongratulationsInfo congratulationsList = 3;
    optional bool isCongratulations = 4;
    optional string flyRedPacketid = 5;
    repeated int64 memberIdList = 6;
    optional bool hasRedPackets = 7;
}
message UnionCeremonyCongratulationsReq {
    required int64 unionId = 1;
    required string wordsKey = 2;
}
message UnionCeremonyCongratulationsResp {
    required int32 ret = 1;
    optional string rewards = 2;
}
message UnionCeremonyCongratulationsGetReq {
    required int64 unionId = 1;
    optional int64 lastCongratulationsTime = 2;
}
message UnionCeremonyCongratulationsGetResp {
    required int32 ret = 1;
    repeated UnionCeremonyCongratulationsInfo congratulationsList = 2;
}
message UnionCeremonyOverReq {
    required int64 unionId = 1;
}
message UnionCeremonyOverResp {
    required int32 ret = 1;
    optional int32 congratulationsNum = 2;
    optional int32 sendRedPacketNum = 3;
}
