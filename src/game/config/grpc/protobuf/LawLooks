message LawLooksLoginSyncMsg {
    optional LawLooksDataMsg lawLooksData = 1;
    optional int32 freeDrawTimesToday = 2;
    optional int32 adDrawTimesToday = 3;
}
message LawLooksSyncMsg {
    optional LawLooksEnterMsg enterMsg = 1;
}
message LawLooksEnterMsg {
    repeated LawLooksDataMsg lawLooksDataList = 1;
    optional int32 freeDrawTimesToday = 2;
    optional int32 adDrawTimesToday = 3;
    repeated LawLooksCombineSkillMsg combineSkillList = 4;
    repeated LawLooksCollectInfo collectInfoList = 5;
    optional int32 drawTimes = 6;
    optional int32 ensureTimes = 7;
    optional int32 resetLawLooksTimesToday = 8;
    optional int32 refreshSkillTimes = 9;
    repeated LawLooksCombatInfo combatInfoList = 10;
    optional int32 extendTimes = 11;
}
message LawLooksCombatInfo{
  optional int32 bodyIndex = 1;
  optional int32 id = 2;
}
message LawLooksCollectInfo{
    optional int32 lawLooksConfigId = 1;
    optional int32 count = 2;
}
message LawLooksDataMsg {
    required int32 id = 1;
    required int32 configId = 2;
    required int32 star = 3;
    repeated LawLookPassiveSkillInfo passiveSkillInfoList = 4;
    optional bool lock = 5;
}
message LawLooksRefreshSkillMsg {
    optional int32 quality = 1;
    optional AttributeDataMsg attributeData = 2;
}
message LawLookPassiveSkillInfo{
    optional LawLooksRefreshSkillMsg refreshSkillMsg = 1;
    optional LawLooksRefreshSkillMsg alternateSkillMsg =2;
}
message LawLooksCombineSkillMsg {
