}
message LawLooksResetReq {
    required int32 lawLooksId = 1;
}
message LawLooksResetResp {
    required int32 ret = 1;
    repeated LawLooksDataMsg lawLooksDataList = 2;
    optional LawLooksDataMsg lawLooksData = 3;
    optional string reward = 4;
}
message LawLooksEquipReq {
    required int32 lawLooksId = 1;
    optional int32 type = 2;
}
message LawLooksEquipResp {
    required int32 ret = 1;
