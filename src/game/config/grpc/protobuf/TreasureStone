message TreasureStoneDealSellRsp {
    required int32 ret = 1;
}
message TreasureStoneDealSellDownReq {
    required int32 id = 1;
}
message TreasureStoneDealSellDownRsp {
    required int32 ret = 1;
}
message TreasureStoneDealBuyReq {
    required string goodsId = 1;
    required string password = 2;
    required int64 price = 3;
    optional int32 num = 4;
}
message TreasureStoneDealBuyRsp {
    required int32 ret = 1;
    repeated GemstoneItemData items = 2;
}
message TreasureStoneDealGetRecordReq {
}
message TreasureStoneDealGetRecordRsp {
    required int32 ret = 1;
    repeated GemstoneMallRecordMsg records = 2;
}
message TreasureStoneDealCollectReq {
    required string goodsId = 1;
    required bool collect = 2;
}
message TreasureStoneDealCollectRsp {
    required int32 ret = 1;
    optional int32 collectSize = 2;
    optional int32 collectNum = 3;
}
message TreasureStoneDealPriceAdjustReq {
    required int32 id = 1;
    required string password = 2;
    required int64 price = 3;
}
message TreasureStoneDealPriceAdjustRsp {
    required int32 ret = 1;
    repeated GemstoneItemData items = 2;
