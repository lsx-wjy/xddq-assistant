    optional int32 separationIndex = 3;
}
message TreasureStoneEquipRsp {
    required int32 ret = 1;
    optional int32 slotId = 2;
    optional int32 itemId = 3;
    repeated StoneSeparationEquipMsg separationEquips = 4;
}
message TreasureStoneUnequipReq {
    required int32 slotId = 1;
    optional int32 separationIndex = 2;
}
message TreasureStoneUnequipRsp {
    required int32 ret = 1;
    optional int32 slotId = 2;
    repeated StoneSeparationEquipMsg separationEquips = 3;
}
message TreasureStoneLockReq {
    required int32 id = 1;
    required bool lock = 2;
    required string password = 3;
}
message TreasureStoneLockRsp {
    required int32 ret = 1;
    optional GemstoneItemData item = 2;
}
message TreasureStoneComposeReq {
    repeated int32 mainIds = 1;
    required int32 helperId = 2;
}
message TreasureStoneComposeRsp {
    required int32 ret = 1;
    optional GemstoneItemData resultItem = 2;
    optional bool success = 3;
    optional int32 failCount = 4;
}
message TreasureStoneComposeLogReq {
}
message TreasureStoneComposeLogRsp {
    required int32 ret = 1;
    repeated StoneComposeLogData logs = 2;
}
message TreasureStoneSync {
    repeated GemstoneItemData itemList = 1;
    repeated int32 slotItemIds = 2;
    optional int32 remainDailyBuyTimes = 3;
    optional int32 serverRound = 4;
    optional int32 sellCount = 5;
    repeated StoneSeparationEquipMsg separationEquips = 6;
}
message TreasureStoneComposeBatchReq {
    repeated TreasureStoneComposeReq composeList = 1;
}
message TreasureStoneComposeBatchRsp {
    required int32 ret = 1;
    repeated TreasureStoneComposeRsp composeList = 2;
}
enum TreasureStoneEnumRedPoint {
    TreasureStone_RedPoint_NewItem = 0;
    TreasureStone_RedPoint_Record = 1;
    TreasureStone_RedPoint_CanInlay = 2;
}
message TreasureStoneSyncRedPoint {
    required string redPoint = 1;
}
