package com.yq.msg.CityMsg;
import "StoneCommon";
enum TreasureStonePb {
    TreasureStone_Enter = 238301;
    TreasureStone_Equip = 238302;
    TreasureStone_Unequip = 238303;
    TreasureStone_Lock = 238304;
    TreasureStone_Sync = 238305;
    TreasureStone_ComposeBatch = 238306;
    TreasureStone_ComposeLog = 238307;
    TreasureStone_SyncRedPoint = 238308;
