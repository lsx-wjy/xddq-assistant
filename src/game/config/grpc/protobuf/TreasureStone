message TreasureStoneEnterReq {
}
message TreasureStoneEnterRsp {
    required int32 ret = 1;
    repeated GemstoneItemData itemList = 2;
    repeated int32 slotItemIds = 4;
    repeated StoneComposeFailData composeFailList = 5;
