message GuardFairyTreeBagWeaponConfigMsg {
    optional int32 id = 1;
    optional int32 unlock = 2;
    optional string chara = 3;
    optional string weight = 4;
    optional string grid = 5;
    optional int32 targetType = 6;
    optional string targetNum = 7;
    optional string attack = 8;
    optional string coldTime = 9;
    optional string specialParam = 10;
    optional string name = 11;
    optional string desc = 12;
    optional string skillDesc = 13;
    optional string specialParamDesc = 14;
    optional string vfx = 15;
}
message GuardFairyTreeBagBlankConfigMsg {
    optional int32 id = 1;
    optional int32 weight = 2;
    optional int32 isAd = 3;
    optional string grid = 4;
}
message GuardFairyTreeBagMonsterConfigMsg {
    optional int32 id = 1;
    optional int32 isBoss = 2;
    optional int32 hpEmp = 3;
    optional int32 speed = 4;
    optional int32 damageReduction = 5;
    optional int32 specialSkill = 6;
