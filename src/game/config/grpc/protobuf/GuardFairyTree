    required int32 activityId = 1;
    required int32 baseId = 2;
    optional bool isUseADTime = 3;
}
message GuardFairyTreeUpdateAdGoodsResp {
    required int32 ret = 1;
    optional int32 goodsAdTimes = 2;
}
message GuardFairyTreeGoodsSaveReq {
    required int32 activityId = 1;
    required int32 baseId = 2;
}
message GuardFairyTreeGoodsSaveResp {
    required int32 ret = 1;
    repeated GuardFairyTreeGoodsItemInfo plateGoods = 3;
    repeated GuardFairyTreeGoodsItemInfo shopGoods = 4;
    optional GuardFairyTreeGoodsItemInfo saveGood = 5;
}
message GuardFairyTreeFightResultReq {
    required int32 activityId = 1;
    required int32 levelId = 2;
    required bool isWin = 4;
    optional GuardFairyTreeFightData fightData = 5;
}
message GuardFairyTreeFightWinResp {
    required int32 ret = 1;
    optional string rewards = 2;
    optional int32 silverCoins = 3;
    repeated GuardFairyTreeGoodsItemInfo shopGoods = 4;
}
message GuardFairyTreeSelectBuffReq {
    required int32 activityId = 1;
    required int32 buffId = 2;
}
message GuardFairyTreeSelectBuffResp {
    required int32 ret = 1;
    repeated int32 buffIdList = 2;
}
message GuardFairyTreeRandomBuffListReq {
    required int32 activityId = 1;
    required int32 type = 2;
    optional bool isUseADTime = 3;
}
message GuardFairyTreeRandomBuffListResp {
    required int32 ret = 1;
    repeated int32 buffPool = 2;
    optional int32 buffAdRandomTimes = 3;
}
message GuardFairyTreeStartBattleReq {
    required int32 activityId = 1;
}
message GuardFairyTreeStartBattleResp {
    required int32 ret = 1;
}
message GuardFairyTreeSetWeaponReq {
    required int32 activityId = 1;
    repeated int32 weaponId = 2;
    optional int32 levelId = 3;
}
