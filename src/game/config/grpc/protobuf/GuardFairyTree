message GuardFairyTreeConfigMsg {
    repeated GuardFairyTreeBagStageConfigMsg bagStageConfig = 1;
    repeated GuardFairyTreeBagWeaponConfigMsg bagWeaponConfig = 2;
    repeated GuardFairyTreeBagBlankConfigMsg bagBlankConfig = 3;
    repeated GuardFairyTreeBagMonsterConfigMsg bagMonsterConfig = 4;
    repeated GuardFairyTreeBagBuffConfigMsg bagBuffConfig = 5;
    repeated GuardFairyTreeBagLevelConfigMsg bagLevelConfig = 6;
}
message GuardFairyTreeBagStageConfigMsg {
    optional int32 id = 1;
    optional int32 stage = 2;
    optional int32 isBoss = 3;
    optional int32 coin = 4;
    optional string monsterList = 5;
    optional int32 unlock = 6;
