    optional int32 type = 10;
}
message GuardFairyTreeBagLevelConfigMsg {
    optional int32 id = 1;
    optional int32 buff = 2;
    optional int32 stage = 3;
}
message GuardFairyTreePowerData {
    optional int32 curPower = 1;
    optional int64 lastRecoverTime = 2;
}
message GuardFairyTreeGridData {
    optional int32 x = 1;
    optional int32 y = 2;
}
message GuardFairyTreeFightData {
    optional int32 exp = 1;
    repeated int32 buffIdList = 2;
    optional int32 buffAdRandomTimes = 3;
    optional int32 treeHp = 4;
    optional int32 goodsAdTimes = 5;
}
message GuardFairyTreeGoodsItemInfo {
    required int32 baseId = 1;
    required int32 itemId = 2;
    optional int32 lv = 3;
    optional bool isAd = 4;
    repeated GuardFairyTreeGridData gridList = 5;
}
message GuardFairyTreeEnterReq {
    required int32 activityId = 1;
}
message GuardFairyTreeEnterResp {
    required int32 ret = 1;
    optional GuardFairyTreePowerData powerData = 2;
    optional int32 passLevelId = 3;
    optional int32 weaponSelected = 4;
    optional int32 curLevelId = 5;
}
message GuardFairyTreeEnterGameReq {
    required int32 activityId = 1;
    required int32 levelId = 2;
}
message GuardFairyTreeEnterGameResp {
    required int32 ret = 1;
    optional int32 round = 2;
    repeated GuardFairyTreeGoodsItemInfo plateGoods = 3;
    repeated GuardFairyTreeGoodsItemInfo shopGoods = 4;
    optional GuardFairyTreeGoodsItemInfo saveGood = 5;
    optional int32 silverCoins = 6;
    repeated GuardFairyTreeGridData plateGridList = 7;
    optional GuardFairyTreeFightData fightData = 8;
    optional int32 refreshNum = 9;
