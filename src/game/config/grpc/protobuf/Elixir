  repeated ElixirSellBuyRecordInfo sellBuyRecordInfos = 2;
}
message ElixirSellBuyRecordInfo{
  required PlayerBaseDataMsg playerBaseData = 1;
  required int32 lv = 2;
  required int32 grassId = 3;
  required int32 num = 4;
  required int64 coin = 5;
  required int64 time = 6;
}
message ElixirAskGrassReq {
  required int32 channelType = 1;
  required int32 grassId = 2;
  required int32 count = 3;
  optional int64 friendPlayerId = 4;
}
message ElixirAskGrassResp {
  required int32 ret = 1;
  optional int32 todayAskNum = 2;
}
message ElixirSendGrassReq {
  required string askUid = 1;
  required int64 receivePlayerId = 2;
  required int32 grassId = 3;
  required int32 count = 4;
  required int32 channelType = 5;
}
message ElixirSendGrassResp {
  required int32 ret = 1;
  optional int32 todaySendNum = 2;
}
message ElixirGrassGiftLogListReq {
  required int32 logTabType = 1;
}
message ElixirGrassGiftLogEntryPb {
  required int32 index = 1;
  required int64 senderId = 2;
  required int32 grassId = 3;
  required int32 count = 4;
  required int64 createTime = 5;
  required bool claimed = 6;
  required int32 logTabType = 7;
  optional ElixirFriendInfo friendInfo = 8;
  optional int32 channelType = 9;
}
message ElixirGrassGiftLogListResp {
  required int32 ret = 1;
  repeated ElixirGrassGiftLogEntryPb entries = 2;
}
message ElixirGrassGiftLogClaimReq {
  required int32 index = 1;
}
message ElixirGrassGiftLogClaimResp {
  required int32 ret = 1;
  optional string grassAward = 2;
}
message ElixirSellInvalidReq {
}
message ElixirSellInvalidResp {
  required int32 ret = 1;
  optional int32 reason = 2;
  repeated ElixirGrassInfo grassList = 3;
}
message ElixirDestinyOrderQuickPlantReq {
  required int32 index = 1;
}
message ElixirDestinyOrderQuickPlantResp {
  required int32 ret = 1;
  repeated ElixirLandInfo land = 2;
  optional string reward = 3;
}
