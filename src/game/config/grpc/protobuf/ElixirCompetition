package com.yq.msg.CityMsg;
import "Common";
import "Union";
import "WatchPlayer";
enum ElixirBattlePb {
    S_ELIXIR_BATTLE_CONFIG = 235801;
    S_ELIXIR_BATTLE_ENTER = 235802;
    S_ELIXIR_BATTLE_UNION_RANK = 235803;
    S_ELIXIR_BATTLE_TASKLIST = 235804;
    S_ELIXIR_BATTLE_ADD_MAXTASKNUM = 235805;
    S_ELIXIR_BATTLE_TASK_ACCEPT = 235806;
    S_ELIXIR_BATTLE_TASK_DELETE = 235807;
    S_ELIXIR_BATTLE_TASK_GIVE_UP = 235808;
