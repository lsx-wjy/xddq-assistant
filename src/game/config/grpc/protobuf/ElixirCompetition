    S_ELIXIR_BATTLE_SYNC = 235814;
    S_ELIXIR_BATTLE_EXPLOIT_SYNC = 235815;
    S_ELIXIR_BATTLE_GETBOX = 235816;
    S_ELIXIR_BATTLE_RED_POINT = 235817;
    S_ELIXIR_BATTLE_DATA_SYNC = 235818;
