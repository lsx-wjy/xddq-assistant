  repeated GodBodyDetailDataMsg detailData = 2;
  optional int32 activityId = 3;
}
/**
1 活动入口图标红点（- 客户端本地判断）
2 排行奖励红点
3 活动开战红点（- 客户端本地判断）
4 竞猜红点
5 竞猜领奖红点
6 转盘红点
7 捐献红点
8 上阵红点
9 指挥官红点
10 膜拜红点
11 妖盟充值红点
12 免费礼包可领取
 */
message PeakFightRedPointReq {
  required int32 activityId = 1;
}
message PeakFightRedPointResp {
  required int32 ret = 1;
  optional string data = 2;
  optional int32 activityId = 3;
}
message PeakFightGetDispatchReportReq {
    optional int32 activityId = 1;
}
message PeakFightGetDispatchReportResp {
    required int32 ret = 1;
    repeated PeakFightReportData dispatchReport = 2;
}
message PeakFightReportData {
  optional PeakFightPlayerBaseMsg member = 1;
  optional int32 fightNum = 2;
}
/* ==================== 同步协议 ======================== */
/* ===================================================== */
message PeakFightBattleSync {
  optional PeakFightSiteBattleMsg battle = 1;
  optional PeakFightReportMsg report = 2;
}
message PeakFightWordsSync {
  optional PeakFightWordsMsg words = 2;
}
message PeakFightReviveSync {
  optional int64 unionId = 1;
  optional int32 site = 2;
  optional int64 reviveBattleId = 3;
  optional int32 reviveItemNum = 4;
  optional int32 totalOccupySec = 5;
  optional int32 roomCostNum = 6;
  optional PeakFightWaitingMsg waitingMsg = 14;
}
message PeakFightSettleSync {
  optional PeakFightSettleMsg settleMsg = 1;
}
message PeakFightVisitWordsSync {
  optional int32 wordIndex = 1;
}
message PeakFightGlobalBuffSync {
  optional int64 unionId = 1;
  optional int64 playerId = 2;
  optional int64 buffTriggerTime = 3;
}
