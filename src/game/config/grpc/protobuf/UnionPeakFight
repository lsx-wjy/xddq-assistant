}
message PeakFightBattleHistoryResp {
  required int32 ret = 1;
  repeated PeakFightBattleHistoryMsg historyMsg = 2;
  optional int32 score = 3;
}
message PeakFightGroupDetailReq {
  required int32 activityId = 1;
