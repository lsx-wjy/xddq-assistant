}
message PeakFightBodyDetailReq {
  required int32 activityId = 1;
  optional int64 playerId = 2;
  optional int32 body = 3;
}
message PeakFightBodyDetailResp {
  required int32 ret = 1;
  optional GodBodyDetailDataMsg detailData = 2;
  optional int32 site = 3;
  optional int32 order = 4;
}
message PeakFightGuessInfoReq {
  required int32 activityId = 1;
}
message PeakFightGuessInfoResp {
  required int32 ret = 1;
