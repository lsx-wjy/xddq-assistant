package com.yq.msg.CityMsg;
import "WatchPlayer";
import "Rank";
import "Palace";
/* ==================== 基础配置 ======================== */
/* ===================================================== */
message RebornTrialLevelConfig {
    optional int32 level = 1;
    optional int64 exp = 2;
    optional int32 map = 3;
    optional string treasure = 4;
    optional int32 cost = 5;
    optional string goodsLevel = 6;
    optional string event = 7;
    optional string refusePower = 8;
    optional string moneyRange = 9;
    optional int64 moneyTriggerBound = 10;
    optional int64 score = 11;
  }
  message RebornTrialGoodsConfig {
    optional int32 level = 1;
    optional int64 basePrice = 2;
    optional string quality = 3;
    optional string statusWeight = 4;
  }
  message RebornTrialItemConfig {
    optional int32 itemId = 1;
    optional int64 priceRate = 2;
    optional int32 isMagic = 3;
  }
  message RebornTrialEventConfig {
    optional int32 eventId = 1;
    optional int32 type = 2;
    optional int32 map = 3;
    optional string item = 4;
    optional string npcType = 5;
    optional string eventOptionName = 6;
    optional string eventDesc = 7;
  }
  message RebornTrialMagicConfig {
    optional int32 magicId = 1;
    optional int32 type = 2;
    optional int32 magicLv = 3;
    optional string addition = 4;
    optional int32 cd = 5;
  }
  message RebornTrialNpcConfig {
    optional int32 npcId = 1;
    optional string talk = 2;
    optional string charaType = 3;
    optional int32 monstersId = 4;
    optional string scale = 5;
    optional string charaChange = 6;
  }
  message RebornTrialGroupConfig {
    optional int32 rankId = 1;
    optional int32 size = 2;
    optional int32 up = 3;
    optional int32 down = 4;
    optional string score = 5;
  }
  message RebornTrialTimeConfig {
    optional int32 timeId = 1;
    optional int32 type = 2;
    optional int32 beginTime = 3;
    optional int32 durationTime = 4;
    optional string param = 5;
  }
  message RebornTrialConfigSync {
    required int32 activityId = 1;
    repeated RebornTrialLevelConfig levelConfig = 2;
    repeated RebornTrialGoodsConfig goodsConfig = 3;
    repeated RebornTrialItemConfig itemConfig = 4;
    repeated RebornTrialEventConfig eventConfig = 5;
    repeated RebornTrialMagicConfig magicConfig = 6;
    repeated RebornTrialGroupConfig groupConfig = 7;
    repeated RebornTrialNpcConfig npcConfig = 8;
    repeated RebornTrialTimeConfig timeConfig = 9;
  }
  /* ==================== 实体包装 ======================== */
  /* ===================================================== */
  message RebornTrialPlayerData {
    optional int32 level = 1;
    optional int64 exp = 2;
    optional int64 totalExp = 3;
    optional int32 map = 4;
    optional int32 hp = 5;
    optional int64 hpRecoveryTime = 6;
    repeated RebornTrialMagicItem magicItem = 7;
    repeated RebornTrialGoodsItem goodsItem = 8;
    optional RebornTrialEvent event = 9;
    optional int32 battleNum = 10;
    optional int64 battleRecoverTime = 11;
    optional int64 exploreCount = 12;
  }
  message RebornTrialMagicItem {
    optional int32 magicType = 1;
    optional int32 magicLevel = 2;
    optional int32 cd = 3;
  }
  message RebornTrialGoodsItem {
    optional int32 id = 1;
    optional int32 goodsId = 2;
    optional int32 level = 3;
    optional int64 value = 4;
    optional int64 price = 5;
    optional int32 quality = 6;
    optional int32 status = 7;
    optional int32 mask = 8;
    optional int32 star = 9;
    optional int32 magicTimes = 10;
  }
  message RebornTrialEvent {
    optional int32 type = 1;
    optional int32 npcId = 2;
    optional int32 stat = 3;
    optional int32 value = 4;
    optional string rewards = 5;
    optional RebornTrialGoodsItem item = 6;
    repeated RebornTrialEventOption option = 7;
    optional int64 param1 = 8;
    optional int64 param2 = 9;
    optional int32 npcType = 10;
  }
  message RebornTrialEventOption {
    optional int32 order = 1;
    optional int64 costExp = 2;
    optional int32 reduceValue = 3;
    optional int32 success = 4;
    optional int64 param1 = 5;
    optional int64 param2 = 6;
  }
  message RebornTrialUnionBaseMsg {
    optional int64 unionId = 1;
    optional int32 flag = 2;
    optional string name = 3;
    optional int64 serverId = 4;
    optional int64 score = 5;
    optional string masterName = 6;
  }
  message RebornTrialBonusInfo {
    optional string name = 1;
    optional int32 itemId = 2;
    optional int64 id = 3;
    optional int32 status=4;
    optional int64 time = 5;
  }
  message RebornTrialBonusRecord {
    optional string nickName =1;
    optional string reward =2;
  }
  message RebornTrialGuessPlayerInfo {
    optional int64 playerId = 1;
    optional int64 serverId = 2;
    optional string name = 3;
  }
  message RebornTrialGuessUnionInfo {
    optional UnionRankTempMsg rankInfo = 1;
    optional int32 selectedCount = 2;
  }
  message RebornTrialUnionChallengeMsg {
    optional RebornTrialUnionBaseMsg base = 1;
    optional int64 reduceBlood = 2;
    optional int64 lastBeAttackTime = 3;
    optional int32 rank = 4;
    optional bool hasDefeated = 5;
    optional int64 shieldTriggerTime = 7;
    optional int32 position = 8;
  }
  message RebornTrialAppearanceMsg {
    optional int32 headIcon = 1;
    optional string wxHeadUrl = 2;
    optional int32  appearanceId = 3;
    optional int32 equipCloudId = 4;
  }
  message RebornTrialUnionChallengeSimpleMsg {
    optional int64 unionId = 1;
    optional int64 leftHp = 2;
    optional int64 finalFame = 3;
    optional bool hasDefeated = 4;
    optional int64 shieldTriggerTime = 5;
    optional int32 level = 6;
  }
  message RebornTrialUnionGroupRankMsg {
    optional int64 unionId = 1;
    optional int32 rank = 2;
  }
  message RebornTrialUnionBattlePlayerMsg {
    optional int32 appearanceId = 1;
    optional int32 cloudId = 2;
    optional int64 exp = 3;
    optional string nickName = 4;
  }
  message RebornTrialReportMsg {
    optional PlayerHeadDataMsg headData = 1;
    optional string nickName = 2;
    optional int64 unionId = 3;
    optional string unionName = 4;
    optional int64 damage = 5;
    optional string targetName = 6;
    optional int64 serverId = 7;
    optional int32 flag = 8;
    optional int32 atkTimes = 9;
    optional int64 time = 10;
  }
  message RebornTrialReportDetailMsg {
    optional string nickName = 1;
    optional int32 atkTimes = 2;
    optional int64 damage = 3;
  }
  message RebornTrialPlayerScoreInfo {
    required int64 playerId = 1 ;
    required string memberName = 2 ;
    required string score = 3;
  }
  message RebornTrialRoundBaseInfo {
    required int32 groupId = 1 ;
    required int32 rank =2 ;
    required string score = 3;
    required int64 point = 4;
    required int32 danId = 5;
  }
  message RebornTrialRoundSettleData {
    optional int32 round = 1;
    optional int32 statues = 2;
    optional int32 groupRank = 3;
    optional int32 rank = 4;
    optional int32 rankScore = 5;
    optional int32 totalScore = 6;
    optional string unionName = 7;
  }
  /* ==================== 请求协议 ======================== */
  /* ===================================================== */
  message RebornTrialEnterActivityReq {
    required int32 activityId = 1;
  }
  message RebornTrialEnterActivityResp {
    optional int32 ret = 1;
    optional int32 selfRank = 2;
    optional int32 round = 3;
    optional int32 group = 4;
    optional int32 rankId = 5;
    optional int64 unionId = 6;
    repeated int32 groups = 7;
    optional string unionName = 8;
    optional PalacePlayerShowMsg worshipPlayer = 9;
    repeated RebornTrialUnionBaseMsg top3Unions = 10;
    optional bool hasWorship = 11;
    optional int32 position = 12;
    optional int32 activityId = 13;
    optional RebornTrialRoundSettleData roundSettleInfo = 14;
  }
  message RebornTrialEnterReq {
    required int32 activityId = 1;
  }
  message RebornTrialEnterResp {
    required int32 ret = 1;
    optional RebornTrialPlayerData playerData = 2;
  }
  message RebornTrialGroupInfoReq {
    required int32 activityId = 1;
    required int32 groupId = 2;
  }
  message RebornTrialGroupInfoResp {
    required int32 ret = 1;
    repeated RebornTrialUnionBaseMsg groupInfo = 2;
  }
  message RebornTrialWorshipReq {
    required int32 activityId = 1;
  }
  message RebornTrialWorshipResp {
    required int32 ret = 1;
    optional string reward = 2;
    optional PalacePlayerShowMsg worshipPlayer = 3;
  }
  message RebornTrialUpLevelReq {
    required int32 activityId = 1;
  }
  message RebornTrialUpLevelResp {
    required int32 ret = 1;
    optional RebornTrialPlayerData playerData = 2;
  }
  message RebornTrialExploreReq {
    required int32 activityId = 1;
  }
  message RebornTrialExploreResp {
    required int32 ret = 1;
    optional RebornTrialPlayerData playerData = 2;
  }
  message RebornTrialSelectOptionReq {
    required int32 activityId = 1;
    required int32 selectIndex = 2;
  }
  message RebornTrialSelectOptionResp {
    required int32 ret = 1;
    optional int64 exp = 2;
    optional int32 hp = 3;
    repeated RebornTrialGoodsItem goodsItem = 4;
    optional RebornTrialEvent event = 5;
    optional int32 level = 6;
    optional int64 totalExp = 7;
    repeated RebornTrialMagicItem magicItem = 8;
  }
  message RebornTrialUseMagicReq {
    required int32 activityId = 1;
    required int32 magicType = 2;
    required int32 goodsId = 3;
  }
  message RebornTrialUseMagicResp {
    required int32 ret = 1;
    optional RebornTrialGoodsItem goodsItem = 2;
    optional RebornTrialMagicItem magicItem = 3;
    optional RebornTrialEvent event = 4;
  }
  message RebornTrialUseItemReq {
    required int32 activityId = 1;
    optional int32 itemId = 2;
    optional int32 num = 3;
  }
  message RebornTrialUseItemResp {
    required int32 ret = 1;
    optional int32 value = 2;
    optional int64 lastRecoveryTime = 3;
    optional int32 battleNum = 4;
  }
  message RebornTrialSkipEventReq {
    required int32 activityId = 1;
  }
  message RebornTrialSkipEventResp {
    required int32 ret = 1;
    optional RebornTrialEvent event = 2;
  }
  message RebornTrialUnionScoreReq {
    required int32 activityId = 1;
    required int64 unionId = 2;
  }
  message RebornTrialUnionScoreResp {
    required int32 ret = 1;
    repeated RebornTrialPlayerScoreInfo scoreInfo = 2;
    optional int64 reduceScore = 3;
  }
  message RebornTrialUnionRoundSummaryReq {
    required int32 activityId = 1;
    required int64 unionId = 2;
  }
  message RebornTrialUnionRoundSummaryResp {
    required int32 ret = 1;
    repeated RebornTrialRoundBaseInfo info = 2;
  }
  /* -------------- 捐献福利包装 （蓬莱仙草、天地灵石） ------------------ */
  message RebornTrialBonusReq {
    required int32 activityId = 1;
  }
  message RebornTrialBonusResp {
    required int32 ret = 1;
    optional int32 exp = 2;
    repeated RebornTrialBonusInfo info = 3;
    optional int32 canReceive = 4;
  }
  message RebornTrialGetBonusResultReq {
    required int32 activityId = 1;
  }
  message RebornTrialGetBonusResultResp {
    required int32 ret = 1;
    optional string reward = 2;
    optional int32 exp = 3;
    optional int32 canReceive = 4;
  }
  message RebornTrialGetBonusItemReq {
    required int32 activityId = 1;
    required int64 id = 2;
  }
  message RebornTrialGetBonusItemResp {
    required int32 ret = 1;
    optional string reward = 2;
    optional int32 exp = 3;
    optional int32 canReceive = 4;
  }
  message RebornTrialSendBonusItemReq {
    required int32 activityId = 1;
    required int32 itemId = 2;
    required int32 num = 3;
  }
  message RebornTrialSendBonusItemResp {
    required int32 ret = 1;
    optional RebornTrialBonusInfo info = 2;
  }
  message RebornTrialBonusRecordReq {
    required int32 activityId = 1;
    required int32 type = 2;
  }
  message RebornTrialBonusRecordResp {
    required int32 ret = 1;
    repeated RebornTrialBonusRecord record = 2;
  }
  /* ----------------------- 竞猜相关 --------------------- */
  message RebornTrialGuessPlayersReq {
    required int32 activityId = 1;
    optional int32 param = 2;
  }
  message RebornTrialGuessPlayersResp {
    required int32 ret = 1;
    optional int32 param = 2;
    repeated RebornTrialGuessPlayerInfo playerList = 3;
  }
  message RebornTrialGuessDataReq {
    required int32 activityId = 1;
  }
  message RebornTrialGuessDataResp {
    required int32 ret = 1;
    repeated RebornTrialGuessUnionInfo infoList = 2;
    repeated int64 unionIdArr = 3;
    repeated int32 rewardRankAchieve = 4;
    optional bool isReceive = 5;
    optional int32 rewardParam = 6;
  }
  message RebornTrialGuessSelectReq {
    required int32 activityId = 1;
    repeated int64 unionIdArr = 2;
  }
  message RebornTrialGuessSelectResp {
    required int32 ret = 1;
  }
  message RebornTrialGuessRewardReq {
    required int32 activityId = 1;
  }
  message RebornTrialGuessRewardResp {
    required int32 ret = 1;
    optional string rewards = 2;
  }
  /* ----------------------- 挑战相关 --------------------- */
  message RebornTrialChallengeListReq {
    required int32 activityId = 1;
  }
  message RebornTrialChallengeListResp {
    required int32 ret = 1;
    repeated RebornTrialUnionChallengeMsg unionMsg = 2;
    repeated int64 advanced = 3;
  }
  message RebornTrialChallengeReq {
    required int32 activityId = 1;
    required int64 unionId = 2;
  }
  message RebornTrialChallengeResp {
    required int32 ret = 1;
    optional int32 free = 2;
    optional int64 battleRecoverTime = 3;
    optional string rewards = 4;
    optional int64 addScore = 5;
    optional int64 reduceScore = 6;
    repeated RebornTrialUnionBattlePlayerMsg result = 7;
    optional int32 defeatNum = 8;
    optional int32 activityId = 9;
  }
  message RebornTrialChallengeHeartBeatReq {
    required int32 activityId = 1;
  }
  message RebornTrialChallengeHeartBeatResp {
    required int32 ret = 1;
  }
  message RebornTrialUnionPlayerListReq {
    required int32 activityId = 1;
    required int64 unionId = 2;
  }
  message RebornTrialUnionPlayerListResp {
    required int32 ret = 1;
    repeated RebornTrialUnionBattlePlayerMsg playerList = 2;
  }
  message RebornTrialReportReq {
    required int32 activityId = 1;
    required int32 type = 2;
  }
  message RebornTrialReportResp {
    required int32 ret = 1;
    repeated RebornTrialReportMsg datas = 2;
  }
  message RebornTrialReportDetailReq {
    required int32 activityId = 1;
    optional int64 unionId = 2;
    optional int32 type = 3;
  }
  message RebornTrialReportDetailResp {
    required int32 ret = 1;
    repeated RebornTrialReportDetailMsg infos = 2;
  }
  /**
  1: 新活动开启红点
  2: 体力达到上限的60%以上
  3: 个人排行奖励待领取时
  4: 个人成就可领取
  5: 可挑战次数
  6: 晶核有可领取奖励
  7: 礼包有可领取免费礼包
  8: 妖盟协力有可领取奖励
  9: 商途宝典可领取奖励
  10: 可竞猜红点
  11: 竞猜奖励可领取
  12: 妖盟排行奖励待领取时
   */
  message RebornTrialRedPointReq {
    required int32 activityId = 1;
  }
  message RebornTrialRedPointResp {
    required int32 ret = 1;
    optional string data = 2;
    optional int32 activityId = 3;
  }
message RebornTrialAutoExploreReq {
    required int32 activityId = 1;
    repeated RebornTrialAutoSettingItem settingItems = 2;
}
message RebornTrialAutoExploreRsp {
  required int32 ret = 1;
  optional RebornTrialPlayerData playerData = 2;
  optional int32 stopType = 3;
  repeated RebornTrialAutoResultMsg results = 4;
  optional int32 hp = 5;
}
message RebornTrialAutoSettingItem {
required RebornTrialEventType event = 1;
  repeated int32 EventSetting = 2;
}
message RebornTrialAutoResultMsg {
  required int32 ret = 1;
  repeated int32 codes = 2;
  repeated bytes msgs = 3;
}
enum RebornTrialEventType {
  BUY = 1;
  SELL = 2;
  SUPPRESS = 3;
  BREAK = 4;
  RESCUE = 5;
  SMELT = 6;
  BET = 7;
  BuyFake = 20;
  SellFake = 21;
  UseMagic = 22;
}
  /* ==================== 同步协议 ======================== */
  /* ===================================================== */
  message RebornTrialChallengeInfoSync {
    required int64 playerId = 1;
    optional string unionName = 2;
    optional string name = 3;
    repeated int64 advanced = 4;
    optional RebornTrialAppearanceMsg appearance = 5;
    /* 被攻击的妖盟信息 */
    optional RebornTrialUnionChallengeSimpleMsg targetUnion = 6;
    repeated RebornTrialUnionGroupRankMsg groupRankMsg = 7;
    optional int64 damage = 8;
  }
