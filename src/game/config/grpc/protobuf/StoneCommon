package com.yq.msg.CityMsg;
message GemstoneItemData {
    required int32 id = 1;
    required int32 configId = 2;
    required int32 level = 3;
    required bool canSell = 4;
    repeated int32 equipped = 5;
    optional int64 beginSellTime = 6;
    optional int64 lastTransactionTime = 7;
    optional bool lock = 8;
    optional int32 masterItemId = 9;
    optional int32 collectNum = 10;
    optional int64 price = 11;
}
message StoneSeparationEquipMsg {
    required int64 index = 1;
    repeated int32 slotItemIds = 2;
}
message StoneComposeFailData {
    required int32 level = 1;
    required int32 failCount = 2;
}
message GemstoneMallRecordMsg {
    required int32 type = 1;
    required int64 targetPlayerId = 2;
    required int64 targetServerId = 3;
    required int64 price = 4;
    required int64 time = 5;
    required int32 gemConfigId = 6;
    required int32 gemLevel = 7;
    required string targetPlayerName = 8;
    optional int32 num = 9;
}
message StoneComposeMaterialData {
    required int32 configId = 1;
    required int32 level = 2;
    required bool helper = 3;
    optional bool canSell = 4;
}
message StoneComposeLogData {
    required int64 time = 1;
    required bool success = 2;
    repeated StoneComposeMaterialData materials = 3;
    optional int32 resultConfigId = 4;
    optional int32 resultLevel = 5;
    optional bool resultCanSell = 6;
}
