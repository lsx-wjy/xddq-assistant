/**
1   首次开启红点
2   礼包红点
3   战令红点
4   排行榜奖励红点
5   体力可使用红点
6   挑战次数可使用红点
7   探索自动处理红点
8   日志红点
9   协助红点
10  通层奖励红点
11  膜拜红点
12  妖盟福利红点
13  妖盟宝箱红点
14  成就奖励红点
15  妖盟协力有可领取奖励
16  未处理事件
 */
message WeYoundRedPointReq {
    required int32 activityId = 1;
}
message WeYoundRedPointResp {
    required int32 ret = 1;
    optional string data = 2;
    optional int32 activityId = 3;
}
