/* ==================== 基础配置 ======================== */
/* ===================================================== */
message WeYoundEventConfig {
    optional int32 id = 1;
    optional int32 type = 2;
    optional string occupation = 3;
    optional string param = 4;
    optional string monsterParam = 5;
    optional string extraParam = 6;
    optional string reward = 7;
    optional int64 points = 8;
    optional int64 exp = 9;
    optional string elixir = 10;
    optional string name = 11;
    optional string desc = 12;
}
message WeYoundElixirConfig {
    optional int32 id = 1;
    optional int32 type = 2;
    optional string param = 3;
}
message WeYoundBuffConfig {
    optional int32 id = 1;
    optional int32 type = 2;
    optional string param = 3;
}
message WeYoundBaseConfig {
    optional int32 level = 1;
    optional int64 hp = 2;
    optional int64 exp = 3;
}
message WeYoundTimeConfig {
    optional int32 timeId = 1;
    optional int32 type = 2;
    optional int32 beginTime = 3;
    optional int32 durationTime = 4;
    optional string param = 5;
}
message WeYoundMapConfig {
    optional int32 floor = 1;
    optional int32 mapId = 2;
    optional int32 cost = 3;
    optional string reward = 4;
    optional int32 star = 5;
    optional int32 points = 6;
    optional string bossProb = 7;
    optional string bossParam = 8;
    optional string event = 9;
    optional string randomEvent = 10;
    optional string bossOccupation = 11;
    optional int32 level = 12;
    optional int32 bossExp = 13;
    optional string elixir = 14;
    optional string extraAttack = 15;
}
message WeYoundGroupConfig {
    optional int32 rankId = 1;
    optional int32 size = 2;
    optional int32 up = 3;
    optional int32 down = 4;
    optional string score = 5;
}
message WeYoundConfigSync {
    required int32 activityId = 1;
    repeated WeYoundEventConfig eventConfig = 2;
    repeated WeYoundBuffConfig buffConfig = 3;
    repeated WeYoundBaseConfig baseConfig = 4;
    repeated WeYoundTimeConfig timeConfig = 5;
    repeated WeYoundMapConfig mapConfig = 6;
    repeated WeYoundGroupConfig groupConfig = 7;
    repeated WeYoundElixirConfig elixirConfig = 8;
}
/* ==================== 实体包装 ======================== */
/* ===================================================== */
message WeYoundPlayerMsg {
